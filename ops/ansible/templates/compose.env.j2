# Auto-generated by Ansible for LoopClose deployment
# File permissions must be 0600 — do not commit or share
APP_ENV=production
APP_NAME=LoopClose

IMAGE_TAG={{ image_tag }}
GIT_SHA={{ image_tag }}

DB_NAME={{ db_name | default('loopclose') }}
DB_USER={{ db_user | default('loopclose') }}
DB_PASSWORD={{ db_password }}
DATABASE_URL=postgresql+psycopg://{{ db_user | default('loopclose') }}:{{ db_password }}@db:5432/{{ db_name | default('loopclose') }}

GRAFANA_ADMIN_USER={{ grafana_admin_user | default('admin') }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
PROMETHEUS_RETENTION={{ prometheus_retention | default('7d') }}

LLM_PROVIDER={{ llm_provider | default('gemini') }}
GEMINI_API_KEY={{ gemini_api_key | default('') }}
GEMINI_MODEL={{ gemini_model | default('gemini-1.5-flash') }}

AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=12000
RETRIEVER=llm

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
SEED_DEMO_DATA={{ seed_demo_data | default('false') }}
PORT=8000

