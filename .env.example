# ── Environment ──────────────────────────────────────────────────────────────
# Dummy values shown. Copy to .env (never commit that file) and fill real values.

APP_ENV=local
APP_NAME=LoopClose

# Database (local SQLite default; on EC2 Compose uses postgresql+psycopg://...)
DATABASE_URL=sqlite:///./local.db

# PostgreSQL container credentials (used on EC2 / Docker Compose)
DB_NAME=loopclose
DB_USER=loopclose
DB_PASSWORD=change_this_to_a_secure_password

# Monitoring credentials (used on EC2 / Docker Compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_to_a_secure_password
PROMETHEUS_RETENTION=7d

# AI provider — set to "fake" if you have no API key (app still boots)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# AI tuning
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=12000

# Retrieval (llm = Level A catalogue linking with keyword fallback)
RETRIEVER=llm

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Demo data
SEED_DEMO_DATA=false

# Server
PORT=8000

# Deployment commit SHA; used by /health to verify the deployed commit
GIT_SHA=
IMAGE_TAG=latest
